<div class="bg-white shadow-md rounded-lg overflow-hidden">
  <% if board.teams.empty? %>
    <div class="px-6 py-8 text-center">
      <p class="text-gray-500">チーム順位が設定されていません。</p>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="border-collapse text-sm w-full">
        <thead>
          <tr>
            <th class="sticky left-0 top-0 z-20 bg-gray-800 text-white px-3 py-2 text-left whitespace-nowrap">
              <%= board.draft.year %>年<br>ドラフト会議
            </th>
            <% board.teams.each do |team| %>
              <th class="sticky top-0 z-10 bg-gray-800 text-white px-3 py-2 whitespace-nowrap font-semibold">
                <%= team.short_name %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% board.rows.each do |row| %>
            <tr class="border-b border-gray-200 even:bg-gray-50">
              <th scope="row" class="sticky left-0 z-10 bg-gray-100 px-3 py-2 text-left whitespace-nowrap font-medium text-gray-700 border-r border-gray-200">
                <%= row.label %>
              </th>
              <% board.teams.each do |team| %>
                <% cell = row.cells[team.id] %>
                <td class="relative px-3 py-2 align-top min-w-[8rem] border-l border-gray-100">
                  <% if cell.pick? %>
                    <%= link_to "", edit_pick_path(cell.pick), class: "absolute inset-0 rounded hover:bg-gray-100", "aria-label": t('picks.index.edit') %>
                    <div class="relative pointer-events-none">
                      <div class="font-medium text-blue-600">
                        <%= link_to cell.pick.player.name, player_path(cell.pick.player), class: "pointer-events-auto relative hover:underline hover:text-blue-800" %>
                      </div>
                      <div class="text-xs text-gray-500"><%= cell.pick.player.affiliation %></div>
                    </div>
                  <% elsif cell.addable? %>
                    <%= link_to "+ 追加", new_pick_path(cell.add_params),
                        class: "block text-center text-xs text-green-700 hover:text-white hover:bg-green-600 border border-dashed border-green-400 rounded px-2 py-2 transition" %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
