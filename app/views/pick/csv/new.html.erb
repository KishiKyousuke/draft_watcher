<div class="container mx-auto px-4 py-8 max-w-4xl">
  <h1 class="text-3xl font-bold mb-8 text-gray-800">指名結果 CSV管理</h1>

  <div class="grid md:grid-cols-2 gap-6">
    <!-- CSVインポート -->
    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
      <h2 class="text-xl font-semibold mb-4 text-gray-700 flex items-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
        </svg>
        CSVインポート
      </h2>
      <p class="text-sm text-gray-600 mb-4">CSVファイルから指名結果データを一括登録します</p>

      <%= form_with local: true, url: pick_csv_import_path, method: :post, multipart: true, data: { turbo: false }, scope: :import, class: "space-y-4" do |f| %>
        <div>
          <%= f.file_field :csv_file,
              accept: ".csv",
              required: true,
              class: "block w-full text-sm text-gray-500
                      file:mr-4 file:py-2 file:px-4
                      file:rounded-md file:border-0
                      file:text-sm file:font-semibold
                      file:bg-blue-50 file:text-blue-700
                      hover:file:bg-blue-100
                      cursor-pointer border border-gray-300 rounded-md" %>
        </div>
        <%= f.submit 'インポート実行',
            class: 'w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition duration-200 cursor-pointer' %>
      <% end %>
    </div>

    <!-- CSVエクスポート -->
    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
      <h2 class="text-xl font-semibold mb-4 text-gray-700 flex items-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
        </svg>
        CSVエクスポート
      </h2>
      <p class="text-sm text-gray-600 mb-4">登録済みの指名結果データをCSVファイルでダウンロードします</p>

      <%= form_with local: true, url: pick_csv_export_path, method: :post, data: { turbo: false }, class: "space-y-4" do |f| %>
        <div class="text-sm text-gray-600 bg-gray-50 p-3 rounded-md border border-gray-200">
          全ての指名結果データがエクスポートされます
        </div>
        <%= f.submit 'エクスポート実行',
            class: 'w-full bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-md transition duration-200 cursor-pointer' %>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <%= link_to '← 指名結果一覧に戻る', picks_path, class: 'text-blue-600 hover:text-blue-800 font-medium' %>
  </div>
</div>
